__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
build/
dist/

# ── uv / pip ───────────────────────────────────────────────────────────────
.uv/
pip-log.txt
pip-delete-this-directory.txt

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

