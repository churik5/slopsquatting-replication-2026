*.db-wal
*.db.backup*
*.db.backup*~

# ── Live spend tracking (keeps personal billing private) ──────────────────
data/spend.json
data/spend*.json

# ── On-disk cache ──────────────────────────────────────────────────────────
data/cache/
data/.cache/

# ── Heavy regenerable master list (~53 MB) ─────────────────────────────────
