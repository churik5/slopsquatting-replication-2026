data/master_lists/npm_package_names.csv

# ── Spracklen prompt corpus (regenerable via Spracklen clone) ─────────────
# Contains verbatim StackOverflow snippets with leaked third-party
# credentials that were already public on StackOverflow before our use.
# We do not redistribute them through this repository.
data/prompts/

# ── External upstream clone (regenerable via git clone) ───────────────────
ext/
